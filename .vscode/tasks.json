{
  // Ctrl+Shift+B builds the plugin (Release), the same build Dalamud loads from
  // XIVFleetCompanion\bin\x64\Release\. Paths are relative to this repository, so it works wherever
  // it is cloned. Open the repository folder itself (the one with XIVFleetCompanion.slnx) in VS Code.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build plugin (Release)",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/XIVFleetCompanion/XIVFleetCompanion.csproj", "-c", "Release"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build plugin (Debug)",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/XIVFleetCompanion/XIVFleetCompanion.csproj", "-c", "Debug"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Get the AutoRetainer part (after a fresh clone)",
      "type": "process",
      "command": "git",
      "args": ["submodule", "update", "--init"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
