<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the plugin's database writing code (FleetWriter.cs) against a scratch Postgres.
       See README.md in this folder. Not part of the plugin build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\XIVFleetCompanion\FleetWriter.cs" Link="FleetWriter.cs" />
    <Compile Include="..\..\XIVFleetCompanion\FCTrackerConnector.cs" Link="FCTrackerConnector.cs" />
    <Compile Include="..\..\XIVFleetCompanion\SyncSchedule.cs" Link="SyncSchedule.cs" />
    <Compile Include="..\..\XIVFleetCompanion\CharacterChoice.cs" Link="CharacterChoice.cs" />
    <Compile Include="..\..\XIVFleetCompanion\CheckReport.cs" Link="CheckReport.cs" />
    <Compile Include="..\..\XIVFleetCompanion\DetailsWriter.cs" Link="DetailsWriter.cs" />
    <Compile Include="..\..\XIVFleetCompanion\SubmarineTrackerReader.cs" Link="SubmarineTrackerReader.cs" />
    <Compile Include="..\..\XIVFleetCompanion\VentureStatsReader.cs" Link="VentureStatsReader.cs" />
    <Compile Include="..\..\XIVFleetCompanion\DatabaseMove.cs" Link="DatabaseMove.cs" />
    <Compile Include="..\..\XIVFleetCompanion\SyncFailure.cs" Link="SyncFailure.cs" />
    <Compile Include="..\..\XIVFleetCompanion\SpeedTest.cs" Link="SpeedTest.cs" />
    <Compile Include="..\..\XIVFleetCompanion\FleetReader.cs" Link="FleetReader.cs" />
    <Compile Include="..\..\XIVFleetCompanion\FleetOrder.cs" Link="FleetOrder.cs" />
    <Compile Include="..\..\XIVFleetCompanion\PartsPlanner.cs" Link="PartsPlanner.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Made-up fleets and the app's Parts answers (the app's tests/db/parts-fixture.js), for PartsPlanner. -->
    <None Include="parts-fixture.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="System.Data.SQLite" Version="2.0.3" />
    <!-- The SQLite engine itself; in the game, Dalamud has already loaded it. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>
</Project>
