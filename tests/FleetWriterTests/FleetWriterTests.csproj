<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the plugin's database writing code (FleetWriter.cs) against a scratch Postgres.
       See README.md in this folder. Not part of the plugin build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\XIVFleetCompanion\FleetWriter.cs" Link="FleetWriter.cs" />
    <Compile Include="..\..\XIVFleetCompanion\FCTrackerConnector.cs" Link="FCTrackerConnector.cs" />
    <Compile Include="..\..\XIVFleetCompanion\SyncSchedule.cs" Link="SyncSchedule.cs" />
    <Compile Include="..\..\XIVFleetCompanion\CharacterChoice.cs" Link="CharacterChoice.cs" />
    <Compile Include="..\..\XIVFleetCompanion\CheckReport.cs" Link="CheckReport.cs" />
    <Compile Include="..\..\XIVFleetCompanion\DetailsWriter.cs" Link="DetailsWriter.cs" />
    <Compile Include="..\..\XIVFleetCompanion\SubmarineTrackerReader.cs" Link="SubmarineTrackerReader.cs" />
    <Compile Include="..\..\XIVFleetCompanion\VentureStatsReader.cs" Link="VentureStatsReader.cs" />
    <Compile Include="..\..\XIVFleetCompanion\DatabaseMove.cs" Link="DatabaseMove.cs" />
    <Compile Include="..\..\XIVFleetCompanion\SyncFailure.cs" Link="SyncFailure.cs" />
    <Compile Include="..\..\XIVFleetCompanion\SpeedTest.cs" Link="SpeedTest.cs" />
    <Compile Include="..\..\XIVFleetCompanion\FleetReader.cs" Link="FleetReader.cs" />
    <Compile Include="..\..\XIVFleetCompanion\FleetOrder.cs" Link="FleetOrder.cs" />
    <Compile Include="..\..\XIVFleetCompanion\PartsPlanner.cs" Link="PartsPlanner.cs" />
    <Compile Include="..\..\XIVFleetCompanion\Universalis.cs" Link="Universalis.cs" />
    <Compile Include="..\..\XIVFleetCompanion\Market.cs" Link="Market.cs" />
    <Compile Include="..\..\XIVFleetCompanion\SubRoutes.cs" Link="SubRoutes.cs" />
    <Compile Include="..\..\XIVFleetCompanion\Loot.cs" Link="Loot.cs" />
    <Compile Include="..\..\XIVFleetCompanion\ShoppingList.cs" Link="ShoppingList.cs" />
    <Compile Include="..\..\XIVFleetCompanion\Trends.cs" Link="Trends.cs" />
    <Compile Include="..\..\XIVFleetCompanion\FleetEdits.cs" Link="FleetEdits.cs" />
    <Compile Include="..\..\XIVFleetCompanion\FightClubImport.cs" Link="FightClubImport.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Made-up fleets and the app's Parts answers (the app's tests/db/parts-fixture.js), for PartsPlanner. -->
    <None Include="parts-fixture.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Canned Universalis listings and the app's live market answers (the app's tests/market-fixture.js). -->
    <None Include="market-fixture.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Made-up fleets and game data, and the app's Subs route answers (the app's tests/db/routes-fixture.js), for SubRoutes. -->
    <None Include="routes-fixture.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- A made-up recorded history and the app's Trends answers (the app's tests/db/trends-fixture.js), for the Trends page. -->
    <None Include="trends-fixture.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The app's edits and the tables after each (the app's tests/db/edits-fixture.js), for the in-game edits. -->
    <None Include="edits-fixture.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Route spreadsheets, the app's reading of them and its import (the app's tests/db/fight-club-fixture.js), for Import Fight Club Data. -->
    <None Include="fight-club-fixture.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="System.Data.SQLite" Version="2.0.3" />
    <!-- The SQLite engine itself; in the game, Dalamud has already loaded it. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>
</Project>
